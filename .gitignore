# Environment variables
.env
.env.local
.env.*.local

# Node dependencies
node_modules/

# package-lock.json is deliberately NOT ignored: `npm ci` needs it, and it is what pins
# the qs override that keeps npm audit clean. It was ignored until CI existed to want it.
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# The live database. Untracked deliberately: it holds user emails and raw
# session cookies, and it changes on every login and price fetch. Snapshots
# come from ./backup-db.sh instead, written outside the repo.
data.db
data.db-wal
data.db-shm
# Since the split there are two of them, plus their write-ahead logs.
portfolio.db
portfolio.db-wal
portfolio.db-shm
identity.db
identity.db-wal
identity.db-shm

# Database backups and legacy files
*.backup*
data.json
data.json.backup

# Logs
logs/
*.log

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
