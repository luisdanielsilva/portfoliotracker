# Database Configuration (SQLite)
# Path to SQLite database file (defaults to ./data.db if not set)
DB_PATH=./data.db

# API Configuration
API_PORT=3000
NODE_ENV=production

# Email Configuration (for Phase 3 alerts)
# Options:
#   - Local postfix: SMTP_HOST=localhost, SMTP_PORT=25
#   - Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, use app password
#   - Sendgrid: SMTP_HOST=smtp.sendgrid.net, SMTP_PORT=587, SMTP_USER=apikey
#   - AWS SES: SMTP_HOST=email-smtp.region.amazonaws.com, SMTP_PORT=587
SMTP_HOST=localhost
SMTP_PORT=25
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
ALERT_EMAIL_FROM=alerts@portfoliotracker.local
# Optional fallback recipient. Alerts now email the owning user's own address.
ALERT_EMAIL_TO=admin@example.com

# Auth (Phase 4 - passwordless magic links)
# Public base URL used to build magic-link URLs sent by email.
APP_BASE_URL=https://www.luisdanielsilva.com/portfoliotracker
AUTH_EMAIL_FROM=login@portfoliotracker.local
# Set to 'true' ONLY for local testing over plain HTTP (drops the Secure cookie flag).
COOKIE_INSECURE=false

# Google sign-in (optional - leave blank to disable and use magic links only).
# Create an OAuth 2.0 Client ID (type: Web application) at
# https://console.cloud.google.com/apis/credentials and register this exact
# authorized redirect URI:  <APP_BASE_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
