# Log rotation for Portfolio Tracker.
#
# logs/price-fetch.log, backup.log and job-health.log are appended to by the systemd
# timer and two cron jobs and were never rotated — they only ever grew.
#
# Install (needs root, once):
#   sudo cp /var/www/portfoliotracker/logrotate.portfoliotracker /etc/logrotate.d/portfoliotracker
#   sudo logrotate -d /etc/logrotate.d/portfoliotracker     # dry run, prints what it would do
#
# copytruncate because the writers hold the file open and are not signalled to reopen it.
/var/www/portfoliotracker/logs/*.log {
    weekly
    rotate 8
    compress
    delaycompress
    missingok
    notifempty
    copytruncate
    su deploy deploy
}
